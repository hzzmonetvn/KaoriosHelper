umask 022

ui_print() { echo "$1"; }

require_new_root() {
  ui_print "*****************************************"
  ui_print " Supported Root Manager Required:       "
  ui_print " • Magisk v26.4+                        "
  ui_print " • KernelSU v0.7.0+                     "
  ui_print " • APatch v1.0.7+                       "
  ui_print "*****************************************"
  exit 1
}

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
elif [ -f /data/adb/ksu/util_functions.sh ]; then
  . /data/adb/ksu/util_functions.sh
elif [ -f /data/adb/ap/util_functions.sh ]; then
  . /data/adb/ap/util_functions.sh
fi

if command -v install_module >/dev/null 2>&1; then
  install_module
  exit 0
else
  # Direct fallback for standard installations
  MODPATH="${0%/*}"
  exit 0
fi
